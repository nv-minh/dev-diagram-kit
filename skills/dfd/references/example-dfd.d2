# REFERENCE for /dfd — order system data flow (online-shop feature). Not a real doc.
# DFD = the DATA view: where data moves between external entities, processes, and stores.
# Notation (Gane-Sarson flavor via D2 shapes):
#   - External entity  = shape: rectangle      + gray dashed border (style.stroke-dash: 3)  -> "outside"
#   - Process          = shape: rectangle; style.border-radius: 10 + green fill, numbered (1.0, 1.1, 1.2)
#   - Data store       = shape: cylinder        + purple fill, numbered (D1, D2)
#   - Data flow        = an edge A -> B: "the DATA that moves"   (label = data, NOT the action)
# QUOTE labels containing ( ) | / :  — e.g. "1.2 Process payment (card)".
# Pastels come from rules/diagram-style.md.
#
# The skill writes TWO files: {slug}-dfd-l0.d2 (context, one process = system) and
# {slug}-dfd-l1.d2 (exploded, processes + stores). Below is a renderable L1; the L0 is the same
# externals + ONE "1.0 Order system" process + the same boundary flows.

direction: right

Customer: "Customer" { shape: rectangle; style.fill: "#EEF1F4"; style.stroke-dash: 3 }
Gateway: "Payment gateway" { shape: rectangle; style.fill: "#EEF1F4"; style.stroke-dash: 3 }

P1: "1.1 Capture order"   { shape: rectangle; style.border-radius: 10; style.fill: "#E6F4EA" }
P2: "1.2 Process payment" { shape: rectangle; style.border-radius: 10; style.fill: "#E6F4EA" }
P3: "1.3 Fulfill order"   { shape: rectangle; style.border-radius: 10; style.fill: "#E6F4EA" }

D1: "D1 Orders"    { shape: cylinder; style.fill: "#F1EAFB" }
D2: "D2 Customers" { shape: cylinder; style.fill: "#F1EAFB" }

Customer -> P1: "order"
P1 -> D1: "order record"
D1 -> P2: "pending order"
P2 -> Gateway: "payment request"
Gateway -> P2: "payment result"
P2 -> D1: "payment status"
D1 -> P3: "paid order"
D2 -> P1: "customer profile"
P3 -> Customer: "confirmation"
